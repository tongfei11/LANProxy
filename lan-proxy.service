[Unit]
Description=LAN Proxy controller
Requires=lan-proxy.socket
After=lan-proxy.socket

[Service]
Type=exec
DynamicUser=yes
User=lan-proxy
RuntimeDirectory=lan-proxy
RuntimeDirectoryMode=0700
UMask=0077
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ExecStart=/usr/bin/python3 /usr/lib/lan-proxy/helper.py
ExecStopPost=/usr/bin/python3 /usr/lib/lan-proxy/helper.py cleanup
TimeoutStopSec=8
